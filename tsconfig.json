{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["types/**/*.ts", "lib/**/*.ts", "modules/**/*.ts", "*.ts"],
  "exclude": ["node_modules", "examples", "test/fixtures"]
}
