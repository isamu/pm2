{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "types/**/*.ts",
    "*.ts",
    "lib/API/ExtraMgmt/Docker.ts",
    "lib/API/Modules/flagExt.ts",
    "lib/API/UX/helpers.ts",
    "lib/API/UX/pm2-ls-minimal.ts",
    "lib/completion.ts",
    "lib/Event.ts",
    "lib/God/ClusterMode.ts",
    "lib/God/Reload.ts",
    "lib/God/Methods.ts",
    "lib/tools/errors.ts",
    "lib/API/pm2-plus/auth-strategies/WebAuth.ts",
    "lib/API/Log.ts",
    "lib/tools/SysMetrics.ts",
    "lib/HttpInterface.ts",
    "lib/ProcessContainerFork.ts",
    "lib/ProcessContainerForkBun.ts",
    "lib/ProcessUtils.ts",
    "lib/tools/Config.ts",
    "lib/tools/deleteFolderRecursive.ts",
    "lib/tools/IsAbsolute.ts",
    "lib/tools/packageRoot.ts",
    "lib/tools/processFile.ts",
    "lib/tools/passwd.ts",
    "lib/tools/sexec.ts",
    "lib/tools/which.ts",
    "lib/TreeKill.ts",
    "lib/VersionCheck.ts",
    "lib/Utility.ts",
    "lib/Watcher.ts"
  ],
  "exclude": ["node_modules", "examples", "test/fixtures"],
  "//": "Files that have been through the migration properly. A file joins this list when its types are written, and gains the strict family by doing so. The ones still waiting are in tsconfig.migrating.json."
}
