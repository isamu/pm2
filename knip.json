{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "bin/pm2",
    "bin/pm2-dev",
    "bin/pm2-docker",
    "bin/pm2-runtime",
    "index.js",
    "test/**/*.{ts,tsx,js,jsx}"
  ],
  "project": ["lib/**/*.{ts,tsx,js}"],
  "rules": {
    "exports": "warn",
    "types": "warn",
    "files": "warn",
    "dependencies": "warn",
    "devDependencies": "warn",
    "unlisted": "warn",
    "binaries": "warn"
  }
}
